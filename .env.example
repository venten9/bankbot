# ==============================================================================
# T-Bank Neobank Telegram Bot — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the values for your deployment:
#   cp .env.example .env
# ==============================================================================

# Telegram Bot API Token obtained from @BotFather
# Example: 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_1234567
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_1234567

# Administrator Telegram User IDs (for /admin RBAC panel access)
# Supported formats:
#   - Comma-separated integers: 123456789,987654321
#   - JSON integer array: [123456789, 987654321]
#   - Single integer: 123456789
ADMIN_IDS=123456789,987654321

# Database connection URL (SQLAlchemy async dialect)
# Default is an asynchronous SQLite database in WAL mode:
DATABASE_URL=sqlite+aiosqlite:///tbank.db

# Annual Percentage Rate (APR) for the 18% Savings Safe account (Накопительный счет)
# Default: 0.18 (equivalent to 18.0% annual yield, daily actual/365 accrual)
SAVINGS_APR=0.18

# Broker commission fee applied to stock purchases and sales in T-Investments
# Default: 0.003 (0.3% per executed transaction)
BROKER_FEE_PERCENT=0.003

# Application Debug Mode (True/False)
# Enables detailed SQL queries and debug log statements
DEBUG=false
